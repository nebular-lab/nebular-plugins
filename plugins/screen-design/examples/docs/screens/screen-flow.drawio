<mxfile host="app.diagrams.net">
  <diagram id="screen-flow" name="画面遷移図">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="note-hidden" value="図に描いていない遷移&lt;br&gt;・どの画面でも、API が 401 を返したら → ログイン（/login）&lt;br&gt;・SCR-002 イベント編集: 権限がないとき、イベントが見つからないとき → SCR-001 イベント一覧" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="640" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ext-online" value="オンライン会場&lt;br&gt;イベントの配信 URL" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ext-help" value="ヘルプ&lt;br&gt;URL は TBD" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="scr-001" value="SCR-001 イベント一覧&lt;br&gt;/events" style="swimlane;whiteSpace=wrap;html=1;startSize=60;collapsible=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="140" width="240" height="340" as="geometry" />
